# Copy this file to .env and fill in your values before running the backend.

# Environment: development | production
ENV=development

# Database connection string
# SQLite (local dev):
DATABASE_URL=sqlite:///./secureid.db
# PostgreSQL (Docker / production):
# DATABASE_URL=postgresql+psycopg2://secureid:secureid@db:5432/secureid

# JWT — MUST be changed to a random 32+ character secret in production
JWT_SECRET_KEY=CHANGE_ME_SUPER_SECRET

# Frontend origin allowed by CORS (add multiple as a JSON list if needed)
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_ORIGIN_DOCKER=http://frontend:5173

# Face recognition microservice
FACE_SERVICE_URL=http://localhost:8001

# Blockchain local node (Hardhat default)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
