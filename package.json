{
  "name": "secureid",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build --filter=@secureid/frontend",
    "build:all": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "dev:frontend": "turbo run dev --filter=@secureid/frontend",
    "dev:backend": "turbo run dev --filter=@secureid/backend",
    "dev:face-service": "turbo run dev --filter=@secureid/face-service",
    "blockchain:node": "turbo run node --filter=@secureid/blockchain",
    "blockchain:deploy": "turbo run deploy --filter=@secureid/blockchain"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=18"
  }
}
